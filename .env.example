# Genera un valor seguro con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_SECRETA_ALEATORIA
DJANGO_DEBUG=1
# Añade aquí la IP/dominio desde el que accederás a Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Pruebas: el enlace de recuperación aparecerá en docker compose logs frontend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correo real, cambia EMAIL_BACKEND a:
# django.core.mail.backends.smtp.EmailBackend
# y configura tu proveedor SMTP en .env (nunca subas ese archivo a Git).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@localhost

# Generar: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AI_INTERNAL_TOKEN=REEMPLAZAR_POR_TOKEN_LARGO

# PostgreSQL local en Docker Compose. No publiques este secreto en Git.
POSTGRES_DB=eduai
POSTGRES_USER=eduai_user
POSTGRES_PASSWORD=CAMBIA_POR_UNA_CLAVE_ALEATORIA_LARGA

# Aceleración (auto = CPU cuando la GPU no es accesible desde PyTorch).
EDUAI_EMBEDDING_DEVICE=auto
# Utilizado por iniciar_eduai.sh: auto | cpu | gpu (NVIDIA).
EDUAI_ACCELERATOR=auto
