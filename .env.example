# Genera un valor seguro con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_SECRETA_ALEATORIA
DJANGO_DEBUG=1
# Añade aquí la IP/dominio desde el que accederás a Django.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,frontend

# Pruebas: el enlace de recuperación aparecerá en docker compose logs frontend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar correo real, cambia EMAIL_BACKEND a:
# django.core.mail.backends.smtp.EmailBackend
# y configura tu proveedor SMTP en .env (nunca subas ese archivo a Git).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@localhost
