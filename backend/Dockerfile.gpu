FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# Tesseract en inglés y español, compiladores para ruedas nativas,
# libgomp para dependencias de ML.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-spa \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.docker.gpu.txt /app/requirements.docker.gpu.txt
# Instala una versión concreta CUDA de torch ANTES de las otras librerías.
# Debes tener drivers NVIDIA y NVIDIA Container Toolkit en el host.
RUN python -m pip install --upgrade pip && \
    python -m pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121 && \
    python -m pip install -r requirements.docker.gpu.txt

COPY . /app
RUN mkdir -p /app/uploads /app/chroma_dbs /app/images /app/exports /app/pdfs /app/.cache/huggingface

EXPOSE 8080
CMD ["python", "eduai-backend.py"]
